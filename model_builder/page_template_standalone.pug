- var name = htmlWebpackPlugin.options.name
- var bundleUrl = "{{ server_path }}static/model_builder-" + name + ".bundle.js"
- var commonBundleUrl = "{{ server_path }}static/model_builder-common.bundle.js"
html
  head
    meta(charset="UTF-8")
    base(href="{{ server_path }}")
  body
    script(type="text/javascript", src=bundleUrl)
    script(type="text/javascript", src=commonBundleUrl)
